# ==========================================
# Llama Trading Engine - Environment Config
# ==========================================

# --- Exchange Configuration ---
EXCHANGE_ID=binance
# Leave MAINNET_API_KEY blank if you only want to use the Testnet Sandbox
MAINNET_API_KEY=
MAINNET_SECRET_KEY=

# --- Testnet Credentials ---
TESTNET_API_KEY=your_binance_testnet_api_key_here
TESTNET_SECRET_KEY=your_binance_testnet_secret_key_here

# --- AI Configuration ---
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5:7b
LLM_ATTEMPT_TIMEOUT=180

# --- RISK SETTINGS ---
RISK_PER_TRADE_PCT=0.02
MAX_CONCURRENT_TRADES=1
MAX_TRADES_PER_24H=3
GLOBAL_MAX_DD_LIMIT=15.0
TRADE_FEE_PERCENT=0.0006

# --- Logging ---
# Valid options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
